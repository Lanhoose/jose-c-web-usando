rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMaster() {
      return signedIn()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == "mestre";
    }

    match /usuarios/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "jogador";
      allow read: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /fichas/{fichaId} {
      allow read: if signedIn()
        && (isMaster() || resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && (isMaster() || request.resource.data.ownerUid == request.auth.uid);
      allow update: if signedIn()
        && (isMaster() || (
          resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
        ));
      allow delete: if signedIn()
        && (isMaster() || resource.data.ownerUid == request.auth.uid);
    }

    // Uma única batalha ativa compartilhada entre o Mestre e os jogadores.
    // Somente o Mestre pode alterar a batalha; jogadores possuem leitura em tempo real.

    // Bestiário é exclusivo do Mestre: jogadores não podem consultar nem alterar.
    match /monstros/{monstroId} {
      allow read, create, update, delete: if isMaster();
    }

    match /campanhas/{campanhaId} {
      allow read: if signedIn();
      allow create, update, delete: if isMaster();
    }

    match /batalhas/{batalhaId} {
      allow read: if signedIn();
      allow create, update, delete: if isMaster();

      match /audioTracks/{trackId} {
        allow read: if signedIn();
        allow create, update, delete: if isMaster();
      }
    }
  }
}
